<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mandrake.augur</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/nice</string>
    <string>-n</string>
    <string>10</string>
    <string>__HOME__/agent-storage/python/py</string>
    <string>__REPO__/augur/bin/augurd.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>20</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>LowPriorityIO</key><true/>
  <key>Umask</key><integer>63</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>AUGUR_HOME</key><string>__AUGUR_HOME__</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/augur.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/augur.err</string>
</dict>
</plist>
