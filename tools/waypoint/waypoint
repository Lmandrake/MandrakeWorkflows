# --------------------------------------------------------------------------- #
# Focus: the current-focus subset of launch aliases, bulk-opened in iTerm2
# --------------------------------------------------------------------------- #
#
# How "already open" is detected -- two signals, either one is enough, because
# the priority is NEVER opening a duplicate (a missed open costs one `launch`).
#
# 1. Title. Every interactive `claude` goes through the wrapper in
#    a shell wrapper, which titles the terminal
#    "Claude: ${PWD:t}" -- the BASENAME OF THE START DIRECTORY, not the -n value.
#    iTerm2 shows it as "Claude: <basename> (<job>)". Titles drift (a live
#    session can end up titled "<basename> (claude)"), so the bare
#    "<basename> (claude)" form is accepted too. The basename is compared
#    exactly, never as a substring: "ATLAS" does not match "ATLAS2".
# 2. Process cwd. A `claude` process on an iTerm2 session's tty whose working
#    directory is the launch directory. Also imperfect -- a session's cwd can
#    move (a session started in one project may sit in another) -- which is
#    why the signals are OR-ed rather than either being trusted alone.

ITERM_LIST_SCRIPT = """
if application id "com.googlecode.iterm2" is not running then return ""
tell application id "com.googlecode.iterm2"
  set outList to {}
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        set end of outList to (name of s) & " ||| " & (tty of s)
      end repeat
    end repeat
  end repeat
  set AppleScript's text item delimiters to linefeed
  return outList as text
end tell
"""

# The command text arrives as argv, so it never needs AppleScript escaping.
# Run the command in an existing (restored, idle) session, found by tty.
ITERM_REUSE_SCRIPT = """
on run argv
  tell application id "com.googlecode.iterm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (tty of s) is (item 2 of argv) then
            tell s to write text (item 1 of argv)
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  error "no iTerm2 session on " & (item 2 of argv)
end run
"""

ITERM_OPEN_SCRIPT = """
on run argv
  tell application id "com.googlecode.iterm2"
    set newWindow to (create window with default profile)
    tell current session of newWindow
      write text (item 1 of argv)
    end tell
  end tell
end run
"""


# A session whose job suffix is a bare shell is a window iTerm2 restored after
# a restart (or one whose claude exited): titled for the project, nothing running.
IDLE_SHELL_JOBS = {"-zsh", "zsh", "-bash", "bash", "-sh", "sh", "login"}

ITERM_BUNDLE_ID = "com.googlecode.iterm2"


def ensure_iterm_running(timeout: float = 45.0) -> None:
    """Start iTerm2 if needed and wait until its restored windows have settled.

    Must run before sessions are listed: at boot iTerm2 is not running, and the
    windows it restores on launch have to be seen (and reused) rather than
    duplicated.
    """
    probe = 'if application id "%s" is running then tell application id "%s" to return count of windows' % (
        ITERM_BUNDLE_ID, ITERM_BUNDLE_ID)
    def count() -> int | None:
        r = subprocess.run(["osascript", "-e", probe + "\nreturn -1"], capture_output=True, text=True, timeout=30)
        out = r.stdout.strip()
        return int(out) if r.returncode == 0 and out.lstrip("-").isdigit() and int(out) >= 0 else None
    if count() is not None:
        return
    subprocess.run(["open", "-b", ITERM_BUNDLE_ID], check=False)
    deadline, last, stable = time.time() + timeout, None, 0
    while time.time() < deadline:
        time.sleep(1.0)
        n = count()
        if n is None:
            continue
        stable = stable + 1 if n == last else 0
        last = n
        if stable >= 2:   # same window count for ~2 s: restoration is done
            return
    if last is None:
        die("iTerm2 did not start (open -b com.googlecode.iterm2).")


def session_job(session_name: str) -> str:
    """The trailing ' (<job>)' of an iTerm2 session name, or ''."""
    m = re.search(r" \(([^()]*)\)$", session_name.strip())
    return m.group(1) if m else ""


def session_title_for(directory: str) -> str:
    """The title the claude.zsh wrapper gives a session started in `directory`."""
    return f"Claude: {Path(directory.rstrip('/')).name}"


def session_matches(session_name: str, directory: str) -> bool:
    """True iff an iTerm2 session name is the Claude session for `directory`.

    Exact on the basename; tolerant only of iTerm2's single trailing
    " (<job>)" suffix.
    """
    title = session_title_for(directory)
    base = Path(directory.rstrip('/')).name
    name = session_name.strip()
    if name == title:
        return True
    if re.fullmatch(re.escape(title) + r" \([^()]*\)", name):
        return True
    return name == f"{base} (claude)"


def list_claude_cwds(ttys: set[str]) -> list[tuple[str, str]]:
    """(tty, cwd) for every `claude` process on one of `ttys` (e.g. '/dev/ttys004')."""
    try:
        ps = subprocess.run(["ps", "-A", "-o", "pid=,tty=,comm="], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return []
    pid_tty: dict[str, str] = {}
    for line in ps.stdout.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and Path(parts[2].strip()).name == "claude":
            tty = "/dev/" + parts[1]
            if tty in ttys:
                pid_tty[parts[0]] = tty
    if not pid_tty:
        return []
    try:
        lo = subprocess.run(["lsof", "-a", "-d", "cwd", "-p", ",".join(pid_tty), "-Fpn"],
                            capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return []
    out: list[tuple[str, str]] = []
    pid = None
    for line in lo.stdout.splitlines():
        if line.startswith("p"):
            pid = line[1:]
        elif line.startswith("n") and pid in pid_tty:
            out.append((pid_tty[pid], line[1:]))
    return out


def _same_dir(a: str, b: str) -> bool:
    return os.path.realpath(a) == os.path.realpath(b)


def parse_iterm_sessions(raw: str) -> list[tuple[str, str]]:
    """Parse ITERM_LIST_SCRIPT output into (name, tty) pairs."""
    out: list[tuple[str, str]] = []
    for line in raw.splitlines():
        if not line.strip():
            continue
        name, _, tty = line.partition(" ||| ")
        out.append((name, tty.strip()))
    return out


def list_iterm_sessions() -> list[tuple[str, str]]:
    """Every open iTerm2 session as (name, tty). [] if iTerm2 isn't running."""
    try:
        res = subprocess.run(["osascript", "-e", ITERM_LIST_SCRIPT],
                             capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        die(f"Could not query iTerm2 sessions: {e}")
    if res.returncode != 0:
        die(f"Could not query iTerm2 sessions (osascript exit {res.returncode}): {res.stderr.strip()}")
    return parse_iterm_sessions(res.stdout)


def open_iterm_window(text: str, layout: "Layout | None" = None) -> None:
    """Open one window running `text`. With a saved layout, open it with that
    Space's profile (iTerm2 switches to the Space itself) and set its bounds."""
    if layout is None:
        argv = [text]
        script = ITERM_OPEN_SCRIPT
    else:
        argv = [text, space_profile_name(layout.space), str(layout.x), str(layout.y),
                str(layout.x + layout.width), str(layout.y + layout.height)]
        script = ITERM_OPEN_LAYOUT_SCRIPT
    res = subprocess.run(["osascript", "-e", script, *argv],
                         capture_output=True, text=True, timeout=30)
    if res.returncode != 0:
        raise RuntimeError(res.stderr.strip() or f"osascript exit {res.returncode}")


def reuse_iterm_session(text: str, tty: str) -> None:
    res = subprocess.run(["osascript", "-e", ITERM_REUSE_SCRIPT, text, tty],
                         capture_output=True, text=True, timeout=30)
    if res.returncode != 0:
        raise RuntimeError(res.stderr.strip() or f"osascript exit {res.returncode}")


def plan_focus_launch(launches: list[Launch], waypoints: list[Waypoint], machine: str,
                      template: str, sessions: list[tuple[str, str]],
                      cwds: list[tuple[str, str]] | None = None) -> list[dict]:
    """Decide, per focus launch on this machine, whether it is open, missing, or unusable.

    Pure (no I/O beyond an is_dir check), so the decision can be tested and
    dry-run before anything opens a window. Each entry carries: launch, dir,
    command, action ('open' | 'reuse' | 'skip-open' | 'skip-nodir' | 'skip-dup'),
    `matched` (the matching session names) and, for 'reuse', `tty`: a session
    titled for this project whose job is a bare shell with no claude on its tty
    (a window iTerm2 restored after a restart). It gets the command typed into
    it instead of a duplicate window opening beside it.
    """
    wp_paths = {w.name.upper(): w.path for w in resolve_for_machine(waypoints, machine)}
    chosen = sorted((l for l in resolve_for_machine(launches, machine) if l.focus),
                    key=lambda l: l.name.upper())
    plan: list[dict] = []
    titles_planned: set[str] = set()
    for l in chosen:
        directory = resolve_launch_dir(l, wp_paths)
        entry = {"launch": l, "dir": directory, "command": "", "matched": [], "action": ""}
        if directory is None or not Path(directory).is_dir():
            entry["action"] = "skip-nodir"
            plan.append(entry)
            continue
        entry["command"] = render_launch_template(l.command or template, l.name, directory)
        entry["matched"] = [f"{n} ||| {t}" for n, t in sessions if session_matches(n, directory)]
        names_by_tty = {t: n for n, t in sessions}
        entry["matched"] += [f"{names_by_tty.get(t, '?')} ||| {t} (claude cwd)"
                             for t, c in (cwds or []) if _same_dir(c, directory)
                             and not any(m.endswith(f"||| {t}") for m in entry["matched"])]
        title = session_title_for(directory)
        claude_ttys = {t for t, _ in (cwds or [])}
        idle = [t for n, t in sessions if session_matches(n, directory)
                and session_job(n) in IDLE_SHELL_JOBS and t not in claude_ttys]
        live = [m for m in entry["matched"] if not any(m.endswith(f"||| {t}") for t in idle)]
        if idle and not live and title not in titles_planned:
            entry["action"], entry["tty"] = "reuse", idle[0]
            titles_planned.add(title)
        elif entry["matched"]:
            entry["action"] = "skip-open"
        elif title in titles_planned:
            entry["action"] = "skip-dup"   # two focus rows share one title; open it once
        else:
            entry["action"] = "open"
            titles_planned.add(title)
        plan.append(entry)
    return plan


def _focus_rows(launches: list[Launch], name: str, machine_arg: str | None) -> list[Launch]:
    rows = [l for l in launches if l.name.upper() == name.upper()]
    if machine_arg is not None:
        key = machine_arg.strip().lower()
        rows = [l for l in rows if l.machine.lower() == key]
    return rows


def _set_focus(args, value: bool) -> int:
    launches = load_launches()
    rows = _focus_rows(launches, args.name, args.machine)
    scope = f" (machine: {args.machine.strip().lower() or 'universal'})" if args.machine is not None else ""
    if not rows:
        die(f"No launch alias named '{args.name}'{scope}. Create it first with "
            f"`waypoint launch add {args.name} --waypoint WP`.")
    for l in rows:
        l.focus = value
    save_launches(launches, load_launch_template())
    labels = ", ".join(l.machine or "universal" for l in rows)
    ok(f"{'Added' if value else 'Removed'} focus on {rows[0].name} ({labels}).")
    return 0


def cmd_focus_add(args) -> int:
    return _set_focus(args, True)


def cmd_focus_remove(args) -> int:
    return _set_focus(args, False)


def cmd_focus_list(args) -> int:
    launches = sorted((l for l in load_launches() if l.focus),
                      key=lambda l: (l.name.upper(), l.machine.lower()))
    if not launches:
        info("No focus launches. Add one with:  waypoint focus add NAME")
        return 0
    machine = current_machine(args.machine)
    wp_paths = {w.name.upper(): w.path for w in resolve_for_machine(load_db(), machine)}
    winners = {(l.name.upper(), l.machine.lower()) for l in resolve_for_machine(load_launches(), machine)}
    name_w = max(len(l.name) for l in launches)
    print(f"{C.d}{'NAME'.ljust(name_w)}  MACHINE    DIR{C.x}")
    for l in launches:
        here = (l.name.upper(), l.machine.lower()) in winners
        directory = resolve_launch_dir(l, wp_paths) if here else None
        mach = (l.machine or "*").ljust(9)
        if here:
            print(f"{l.name.ljust(name_w)}  {mach}  {directory or '(not resolvable here)'}")
        else:
            print(f"{C.d}{l.name.ljust(name_w)}  {mach}  (other machine){C.x}")
    return 0


def cmd_focus_launch(args) -> int:
    machine = current_machine(args.machine)
    if not args.dry_run:
        ensure_iterm_running()
    sessions = list_iterm_sessions()
    cwds = list_claude_cwds({t for _, t in sessions})
    plan = plan_focus_launch(load_launches(), load_db(), machine, load_launch_template(), sessions, cwds)
    if args.only:
        wanted = {n.upper() for n in args.only}
        unknown = wanted - {e["launch"].name.upper() for e in plan}
        if unknown:
            die(f"Not a focus launch on {machine}: {', '.join(sorted(unknown))}")
        plan = [e for e in plan if e["launch"].name.upper() in wanted]
    if not plan:
        info("No focus launches on this machine. Add one with:  waypoint focus add NAME")
        return 0
    layouts = {l.name.upper(): l for l in load_layouts() if l.machine == machine}
    if not args.dry_run and any(e["action"] == "open" and e["launch"].name.upper() in layouts for e in plan):
        try:
            provision_space_profiles(max([l.space for l in layouts.values()] + [desktop_count()]))
        except Exception as ex:
            warn(f"could not provision {SPACE_PROFILE_PREFIX}N profiles ({ex}); saved layouts may not apply")
    verb = "would open" if args.dry_run else "opening"
    failures = 0
    for e in plan:
        name = e["launch"].name
        if e["action"] == "skip-open":
            print(f"{C.d}open     {name}  <- {'; '.join(e['matched'])}{C.x}")
        elif e["action"] == "skip-nodir":
            warn(f"skip     {name}: directory not available on {machine} ({e['dir'] or 'unresolved'})")
        elif e["action"] == "skip-dup":
            warn(f"skip     {name}: shares the title '{session_title_for(e['dir'])}' with another focus row")
        elif e["action"] == "reuse":
            text = f"cd {sh_squote(e['dir'])} && {e['command']}"
            print(f"{C.g}{'would reuse' if args.dry_run else 'reusing'}{C.x}  {name}  (idle restored window "
                  f"{e['tty']})  $ {text}")
            if not args.dry_run:
                try:
                    reuse_iterm_session(text, e["tty"])
                except Exception as ex:
                    failures += 1
                    err(f"failed to reuse {name}: {ex}")
        else:
            text = f"cd {sh_squote(e['dir'])} && {e['command']}"
            lay = layouts.get(name.upper())
            where = (f"  {C.b}[Space {lay.space} @ {lay.x},{lay.y} {lay.width}x{lay.height}]{C.x}"
                     if lay else "")
            print(f"{C.g}{verb}{C.x}  {name}  $ {text}{where}")
            if not args.dry_run:
                try:
                    open_iterm_window(text, lay)
                except Exception as ex:  # report, keep going with the rest
                    failures += 1
                    err(f"failed to open {name}: {ex}")
    n_open = sum(e["action"] in ("open", "reuse") for e in plan)
    n_have = sum(e["action"] == "skip-open" for e in plan)
    if args.dry_run:
        info(f"{n_have} already open, {n_open} to open (dry run: nothing opened).")
    else:
        info(f"{n_have} already open, {n_open - failures} opened"
             f"{f', {failures} FAILED' if failures else ''}.")
    if not args.dry_run and args.arrange and failures < n_open:
        time.sleep(4)   # let each new claude title its session before layout apply matches it
        if cmd_layout_apply(argparse.Namespace(machine=args.machine, only=args.only, dry_run=False)):
            failures += 1
    return 1 if failures else 0


# --------------------------------------------------------------------------- #
# Layouts: which Space + bounds each focus window had, restored on focus launch
# --------------------------------------------------------------------------- #
#
# The Space is restored by iTerm2 itself: a profile's Window > Space setting
# ("Space N") makes iTerm2 switch to Desktop N and open the new window there.
# iTerm2 performs that switch by invoking Mission Control's "Switch to Desktop
# N" keyboard shortcut, so those shortcuts must be ENABLED (System Settings >
# Keyboard > Keyboard Shortcuts > Mission Control) or the window opens on the
# current Space. Only Spaces 1-9 exist in iTerm2's setting.
#
# The profiles are an iTerm2 Dynamic Profiles file Waypoint owns outright
# (SPACE_PROFILES_FILE): one "Claude-SpaceN" per desktop, each a copy of the
# base profile (the iTerm2 default profile, i.e. what focus launch used before)
# with only "Space" added. Reading Spaces uses Machinist's read-only
# `windowspaces` tool; nothing here moves a window or switches a Space except
# iTerm2 honouring the profile when Waypoint creates a NEW window.

LAYOUT_DB_PATH = DATA_DIR / "layouts.md"
SPACE_PROFILE_PREFIX = "Claude-Space"
ITERM_PLIST = Path.home() / "Library/Preferences/com.googlecode.iterm2.plist"
DYNAMIC_PROFILES_DIR = Path.home() / "Library/Application Support/iTerm2/DynamicProfiles"
SPACE_PROFILES_FILE = DYNAMIC_PROFILES_DIR / "waypoint-spaces.json"
ITERM_MAX_SPACE = 9


def windowspaces_tool() -> Path:
    return Path(os.environ.get("WAYPOINT_WINDOWSPACES")
                or Path.home() / "dev/Machinist/tools/bin/windowspaces")


class Layout:
    __slots__ = ("name", "machine", "space", "x", "y", "width", "height", "saved")

    def __init__(self, name: str, machine: str, space: int, x: int, y: int, width: int, height: int,
                 saved: str = ""):
        self.name, self.machine = name, machine.lower()
        self.space, self.x, self.y, self.width, self.height = int(space), int(x), int(y), int(width), int(height)
        self.saved = saved or _dt.datetime.now().strftime("%Y-%m-%d %H:%M")


LAYOUT_DB_HEADER = """\
# Window layouts database

Where each focus project's iTerm2 window sat, per machine: its macOS Space
(Mission Control desktop number) and bounds. `waypoint layout save` records the
currently open focus windows here; `waypoint focus launch` reopens a missing
one on its saved Space, at its saved bounds, through the matching
`Claude-SpaceN` iTerm2 profile. A project with no row here opens exactly as
before (default profile, current Space).

Columns:
- **Name** — the launch alias (launches.md).
- **Machine** — machine key (`waypoint machine`). Always set: Spaces and
  screen coordinates mean nothing on another machine.
- **Space** — 1-based desktop number on the window's display.
- **X** / **Y** / **Width** / **Height** — window bounds in points, top-left
  origin (the coordinates iTerm2's AppleScript `bounds` uses).
- **Saved** — when this row was captured.

| Name | Machine | Space | X | Y | Width | Height | Saved |
|------|---------|-------|---|---|-------|--------|-------|
"""


def load_layouts() -> list[Layout]:
    if not LAYOUT_DB_PATH.exists():
        return []
    rows: list[Layout] = []
    in_table = seen_sep = False
    for raw in LAYOUT_DB_PATH.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line.startswith("|"):
            in_table = False
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if [c.lower() for c in cells[:2]] == ["name", "machine"]:
            in_table, seen_sep = True, False
            continue
        if in_table and not seen_sep and set("".join(cells)) <= set("-: "):
            seen_sep = True
            continue
        if in_table and seen_sep and len(cells) >= 7 and cells[0]:
            try:
                rows.append(Layout(*cells[:7], saved=cells[7] if len(cells) > 7 else ""))
            except ValueError:
                warn(f"layouts.md: skipping unparseable row: {line}")
    return rows


def save_layouts(layouts: list[Layout]) -> None:
    layouts = sorted(layouts, key=lambda l: (l.name.upper(), l.machine))
    lines = [LAYOUT_DB_HEADER.rstrip("\n")]
    for l in layouts:
        lines.append(f"| {l.name} | {l.machine} | {l.space} | {l.x} | {l.y} | {l.width} | {l.height} | {l.saved} |")
    lines.append(LAUNCH_DB_FOOTER)
    LAYOUT_DB_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")


def probe_windows() -> dict:
    """Run `windowspaces --json` (read-only). {'displays': [...], 'windows': {wid: row}}."""
    tool = windowspaces_tool()
    if not tool.exists():
        die(f"{tool} not found. Build it:  sh ~/dev/Machinist/tools/build.sh")
    res = subprocess.run([str(tool), "--json"], capture_output=True, text=True, timeout=30)
    if res.returncode != 0:
        die(f"windowspaces failed (exit {res.returncode}): {res.stderr.strip()}")
    data = json.loads(res.stdout)
    return {"displays": data.get("displays", []), "windows": {w["wid"]: w for w in data.get("windows", [])}}


def desktop_count(probe: dict | None = None) -> int:
    """Desktops on the display with the most, capped at iTerm2's 9."""
    try:
        probe = probe or probe_windows()
    except SystemExit:
        return 0
    n = max((d.get("desktops", 0) for d in probe["displays"]), default=0)
    return min(n, ITERM_MAX_SPACE)


# Window id ||| session name ||| tty, one line per session. iTerm2's window id
# is the CoreGraphics window number windowspaces reports.
ITERM_WINDOWS_SCRIPT = """
if application id "com.googlecode.iterm2" is not running then return ""
tell application id "com.googlecode.iterm2"
  set outList to {}
  repeat with w in windows
    set wid to (id of w) as text
    repeat with t in tabs of w
      repeat with s in sessions of t
        set end of outList to wid & " ||| " & (name of s) & " ||| " & (tty of s)
      end repeat
    end repeat
  end repeat
  set AppleScript's text item delimiters to linefeed
  return outList as text
end tell
"""

ITERM_OPEN_LAYOUT_SCRIPT = """
on run argv
  tell application id "com.googlecode.iterm2"
    set newWindow to (create window with profile (item 2 of argv))
    set bounds of newWindow to {(item 3 of argv) as integer, (item 4 of argv) as integer, (item 5 of argv) as integer, (item 6 of argv) as integer}
    tell current session of newWindow
      write text (item 1 of argv)
    end tell
  end tell
end run
"""


def parse_iterm_windows(raw: str) -> list[tuple[int, str, str]]:
    out: list[tuple[int, str, str]] = []
    for line in raw.splitlines():
        parts = line.split(" ||| ")
        if len(parts) == 3 and parts[0].strip().isdigit():
            out.append((int(parts[0]), parts[1], parts[2].strip()))
    return out


def list_iterm_windows() -> list[tuple[int, str, str]]:
    res = subprocess.run(["osascript", "-e", ITERM_WINDOWS_SCRIPT], capture_output=True, text=True, timeout=30)
    if res.returncode != 0:
        die(f"Could not query iTerm2 windows (osascript exit {res.returncode}): {res.stderr.strip()}")
    return parse_iterm_windows(res.stdout)


def space_profile_name(space: int) -> str:
    return f"{SPACE_PROFILE_PREFIX}{space}"


def _iterm_default_profile() -> tuple[str, dict | None]:
    """(name, dynamic-profile dict or None) of iTerm2's default profile."""
    guid = ""
    names: dict[str, str] = {}
    if ITERM_PLIST.exists():
        with open(ITERM_PLIST, "rb") as f:
            prefs = plistlib.load(f)
        guid = prefs.get("Default Bookmark Guid", "")
        names = {b.get("Guid", ""): b.get("Name", "") for b in prefs.get("New Bookmarks", [])}
    for p in sorted(DYNAMIC_PROFILES_DIR.glob("*.json")) if DYNAMIC_PROFILES_DIR.is_dir() else []:
        if p == SPACE_PROFILES_FILE:
            continue
        try:
            for prof in json.loads(p.read_text(encoding="utf-8")).get("Profiles", []):
                if prof.get("Guid") == guid:
                    return prof.get("Name", ""), prof
        except (OSError, ValueError):
            continue
    if guid in names:
        return names[guid], None
    die("Could not determine iTerm2's default profile (no 'Default Bookmark Guid').")


def render_space_profiles(count: int, base_name: str, base: dict | None) -> str:
    """The Dynamic Profiles JSON for Claude-Space1..count, each = base + Space."""
    profiles = []
    for n in range(1, count + 1):
        prof = {k: v for k, v in (base or {}).items() if k not in ("Name", "Guid", "Rewritable")}
        if base is None:
            prof["Dynamic Profile Parent Name"] = base_name
        prof.update({"Name": space_profile_name(n), "Guid": f"WAYPOINT-SPACE-PROFILE-{n}", "Space": n})
        profiles.append(prof)
    return json.dumps({"Profiles": profiles}, indent=2, sort_keys=True) + "\n"


def provision_space_profiles(count: int) -> bool:
    """Write the Claude-SpaceN profiles file if its content would change. True if written."""
    count = max(1, min(count, ITERM_MAX_SPACE))
    base_name, base = _iterm_default_profile()
    text = render_space_profiles(count, base_name, base)
    if SPACE_PROFILES_FILE.exists() and SPACE_PROFILES_FILE.read_text(encoding="utf-8") == text:
        return False
    DYNAMIC_PROFILES_DIR.mkdir(parents=True, exist_ok=True)
    tmp = DYNAMIC_PROFILES_DIR.parent / ".waypoint-spaces.json.tmp"   # outside the watched folder
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, SPACE_PROFILES_FILE)
    time.sleep(1.5)   # iTerm2 reloads the folder on change; give it a moment before use
    return True


def cmd_layout_save(args) -> int:
    machine = current_machine(args.machine)
    windows = list_iterm_windows()
    sessions = [(n, t) for _, n, t in windows]
    wid_by_tty = {t: w for w, _, t in windows}
    cwds = list_claude_cwds({t for _, t in sessions})
    plan = plan_focus_launch(load_launches(), load_db(), machine, load_launch_template(), sessions, cwds)
    probe = probe_windows()
    layouts = {(l.name.upper(), l.machine): l for l in load_layouts()}
    saved = 0
    for e in plan:
        name = e["launch"].name
        if e["action"] != "skip-open":
            print(f"{C.d}not open {name}{C.x}")
            continue
        wids = []
        for m in e["matched"]:
            mt = re.search(r"\|\|\| (/dev/\S+)", m)
            if mt and wid_by_tty.get(mt.group(1)) not in (None, *wids):
                wids.append(wid_by_tty[mt.group(1)])
        row = next((probe["windows"][w] for w in wids if w in probe["windows"]), None)
        if row is None:
            warn(f"skip     {name}: window {wids or '?'} not found by windowspaces")
            continue
        if row["space"] < 1:
            warn(f"skip     {name}: window is on {'all Spaces' if row['space'] == 0 else 'an unknown Space'}")
            continue
        if row["space"] > ITERM_MAX_SPACE:
            warn(f"skip     {name}: Space {row['space']} is beyond iTerm2's Space 1-{ITERM_MAX_SPACE}")
            continue
        if len(wids) > 1:
            warn(f"{name}: {len(wids)} matching windows; saving window {row['wid']}")
        lay = Layout(name, machine, row["space"], row["x"], row["y"], row["width"], row["height"])
        layouts[(name.upper(), machine)] = lay
        saved += 1
        ok(f"saved    {name}: Space {lay.space} @ {lay.x},{lay.y} {lay.width}x{lay.height}")
    save_layouts(list(layouts.values()))
    n = desktop_count(probe)
    wrote = provision_space_profiles(max([l.space for l in layouts.values() if l.machine == machine] + [n]))
    info(f"{saved} layout(s) saved to {LAYOUT_DB_PATH}; {SPACE_PROFILE_PREFIX}1-{min(max(n, 1), ITERM_MAX_SPACE)} "
         f"profiles {'written' if wrote else 'already current'} ({SPACE_PROFILES_FILE}).")
    return 0


def cmd_layout_show(args) -> int:
    machine = current_machine(args.machine)
    rows = [l for l in load_layouts() if l.machine == machine]
    if not rows:
        info(f"No saved layouts for {machine}. Capture them with:  waypoint layout save")
        return 0
    w = max(len(l.name) for l in rows)
    print(f"{C.d}{'NAME'.ljust(w)}  SPACE  BOUNDS                 SAVED{C.x}")
    for l in sorted(rows, key=lambda l: (l.space, l.name.upper())):
        print(f"{l.name.ljust(w)}  {str(l.space).ljust(5)}  "
              f"{f'{l.x},{l.y} {l.width}x{l.height}'.ljust(21)}  {l.saved}")
    return 0


def cmd_layout_forget(args) -> int:
    machine = current_machine(args.machine)
    rows = load_layouts()
    keep = [l for l in rows if not (l.name.upper() == args.name.upper() and l.machine == machine)]
    if len(keep) == len(rows):
        die(f"No saved layout for {args.name} on {machine}.")
    save_layouts(keep)
    ok(f"Forgot the layout for {args.name} on {machine}; it will open on the current Space.")
    return 0


SPACE_KEY_CODES = {1: 18, 2: 19, 3: 20, 4: 21, 5: 23, 6: 22, 7: 26, 8: 28, 9: 25}


def uimovespace_tool() -> Path:
    return Path(os.environ.get("WAYPOINT_UIMOVESPACE")
                or Path.home() / "dev/Machinist/tools/bin/uimovespace")


def plan_layout_apply(plan: list[dict], layouts: dict[str, "Layout"], windows: list[tuple[int, str, str]],
                      probe: dict, only: set[str] | None = None) -> list[dict]:
    """Per focus launch: where its open window is vs. where layouts.md wants it.

    Pure. action: 'move' (wrong Space), 'resize' (right Space, wrong bounds),
    'ok', 'skip-nolayout', 'skip-closed', 'skip-nowin' (no windowspaces row).
    `plan` is plan_focus_launch's output; `layouts` maps NAME.upper() -> Layout.
    """
    wid_by_tty = {t: w for w, _, t in windows}
    out: list[dict] = []
    for e in plan:
        name = e["launch"].name
        if only and name.upper() not in only:
            continue
        ent = {"name": name, "wid": None, "layout": layouts.get(name.upper()), "row": None, "action": ""}
        if e["action"] != "skip-open":
            ent["action"] = "skip-closed"
        elif ent["layout"] is None:
            ent["action"] = "skip-nolayout"
        else:
            wids = []
            for m in e["matched"]:
                mt = re.search(r"\|\|\| (/dev/\S+)", m)
                if mt and wid_by_tty.get(mt.group(1)) not in (None, *wids):
                    wids.append(wid_by_tty[mt.group(1)])
            row = next((probe["windows"][w] for w in wids if w in probe["windows"]), None)
            if row is None:
                ent["action"] = "skip-nowin"
            else:
                lay = ent["layout"]
                ent["wid"], ent["row"] = row["wid"], row
                if row["space"] != lay.space:
                    ent["action"] = "move"
                elif (row["x"], row["y"], row["width"], row["height"]) != (lay.x, lay.y, lay.width, lay.height):
                    ent["action"] = "resize"
                else:
                    ent["action"] = "ok"
        out.append(ent)
    return out


def _osa(script: str) -> subprocess.CompletedProcess:
    return subprocess.run(["osascript", "-e", script], capture_output=True, text=True, timeout=30)


def _goto_space(n: int) -> None:
    if n not in SPACE_KEY_CODES:
        raise RuntimeError(f"no keyboard shortcut for Space {n}")
    r = _osa(f'tell application "System Events" to key code {SPACE_KEY_CODES[n]} using control down')
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip())
    time.sleep(0.9)


def _set_bounds(wid: int, lay: "Layout") -> None:
    r = _osa('tell application id "com.googlecode.iterm2"\nactivate\nselect (first window whose id is %d)\n'
             'set bounds of (first window whose id is %d) to {%d, %d, %d, %d}\nend tell'
             % (wid, wid, lay.x, lay.y, lay.x + lay.width, lay.y + lay.height))
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip())


def cmd_layout_apply(args) -> int:
    machine = current_machine(args.machine)
    windows = list_iterm_windows()
    sessions = [(n, t) for _, n, t in windows]
    cwds = list_claude_cwds({t for _, t in sessions})
    plan = plan_focus_launch(load_launches(), load_db(), machine, load_launch_template(), sessions, cwds)
    layouts = {l.name.upper(): l for l in load_layouts() if l.machine == machine}
    only = {n.upper() for n in args.only} if args.only else None
    if only:
        unknown = only - {e["launch"].name.upper() for e in plan}
        if unknown:
            die(f"Not a focus launch on {machine}: {', '.join(sorted(unknown))}")
    probe = probe_windows()
    steps = plan_layout_apply(plan, layouts, windows, probe, only)
    tool = uimovespace_tool()
    if not args.dry_run and any(s["action"] == "move" for s in steps) and not tool.exists():
        die(f"{tool} not found. Build it:  sh ~/dev/Machinist/tools/build.sh")
    for s in steps:
        lay, row, a = s["layout"], s["row"], s["action"]
        if a == "ok":
            print(f"{C.d}ok       {s['name']}  Space {lay.space} @ {lay.x},{lay.y} {lay.width}x{lay.height}{C.x}")
        elif a == "move":
            print(f"{C.g}move     {s['name']}  Space {row['space']} -> {lay.space}, bounds "
                  f"-> {lay.x},{lay.y} {lay.width}x{lay.height}{C.x}")
        elif a == "resize":
            print(f"{C.g}resize   {s['name']}  {row['x']},{row['y']} {row['width']}x{row['height']} -> "
                  f"{lay.x},{lay.y} {lay.width}x{lay.height}{C.x}")
        elif a == "skip-nolayout":
            print(f"{C.d}skip     {s['name']}: no saved layout (waypoint layout save){C.x}")
        elif a == "skip-closed":
            print(f"{C.d}skip     {s['name']}: not open{C.x}")
        else:
            warn(f"skip     {s['name']}: window not found by windowspaces")
    todo = [s for s in steps if s["action"] in ("move", "resize")]
    if args.dry_run or not todo:
        info(f"{len(todo)} window(s) to fix{' (dry run: nothing touched)' if args.dry_run else ''}.")
        return 0
    cur = next((d.get("current") for d in probe["displays"] if d.get("current", -1) > 0), 1)
    front = _osa('tell application id "com.googlecode.iterm2" to return id of front window')
    front_wid = int(front.stdout.strip()) if front.returncode == 0 and front.stdout.strip().isdigit() else None
    failures = 0
    here = cur
    for s in [s for s in todo if s["action"] == "move"]:
        lay, wid = s["layout"], s["wid"]
        try:
            now = probe_windows()
            row = now["windows"].get(wid) or s["row"]
            if row["space"] < 1:
                raise RuntimeError("window's Space is unknown (iTerm2 still restoring?); rerun layout apply")
            if row["space"] != here:
                _goto_space(row["space"])
                here = row["space"]
            _set_bounds(wid, lay)
            time.sleep(0.6)
            r = subprocess.run([str(tool), str(lay.x + lay.width // 2), str(lay.y + 13), str(lay.space)],
                               capture_output=True, text=True, timeout=30)
            if r.returncode != 0:
                raise RuntimeError(f"uimovespace: {r.stderr.strip() or r.returncode}")
            here = lay.space   # uimovespace leaves us on the destination desktop
            time.sleep(0.5)
            got = probe_windows()["windows"].get(wid, {}).get("space")
            if got != lay.space:
                raise RuntimeError(f"window is on Space {got}, wanted {lay.space}")
            ok(f"moved    {s['name']} -> Space {lay.space}")
        except Exception as ex:
            failures += 1
            err(f"failed   {s['name']}: {ex}")
    final = probe_windows()
    for s in todo:
        row = final["windows"].get(s["wid"])
        lay = s["layout"]
        if row and (row["x"], row["y"], row["width"], row["height"]) != (lay.x, lay.y, lay.width, lay.height):
            try:
                _set_bounds(s["wid"], lay)
            except Exception as ex:
                failures += 1
                err(f"failed   {s['name']} bounds: {ex}")
    try:
        if here != cur:
            _goto_space(cur)
        if front_wid is not None:
            _osa('tell application id "com.googlecode.iterm2" to select (first window whose id is %d)' % front_wid)
    except Exception as ex:
        warn(f"could not restore Space {cur}: {ex}")
    info(f"{len(todo) - failures} fixed, {failures} failed.")
    return 1 if failures else 0


def cmd_layout_profiles(args) -> int:
    n = args.count or desktop_count()
    if n < 1:
        die("Could not count desktops; pass --count N.")
    wrote = provision_space_profiles(n)
    ok(f"{SPACE_PROFILE_PREFIX}1-{min(n, ITERM_MAX_SPACE)} {'written to' if wrote else 'already current in'} "
       f"{SPACE_PROFILES_FILE}")
    return 0


