        return 0

    machine = current_machine(args.machine)
    wp_paths = {w.name.upper(): w.path for w in resolve_for_machine(load_db(), machine)}
    winners = {id(l) for l in resolve_for_machine(launches, machine)}

    name_w = max(len(l.name) for l in launches)
    mach_w = max(max((len(l.machine) for l in launches), default=1), len("MACHINE"))
    print(f"{C.d}{'NAME'.ljust(name_w)}  STATUS  {'MACHINE'.ljust(mach_w)}  DIR / COMMAND{C.x}")
    for l in launches:
        mach_label = (l.machine or "*").ljust(mach_w)
