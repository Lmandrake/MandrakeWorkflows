                mark = f"{C.r}MISS{C.x}"
            print(f"{l.name.ljust(name_w)}  {mark}  {mach_label}  {target}")
            cmd = render_launch_template(l.command or template, l.name, directory or "{DIR}")
            print(f"{' ' * name_w}          {C.d}$ {cmd}{C.x}")
        else:
            print(f"{C.d}{l.name.ljust(name_w)}  other {mach_label}  {target}{C.x}")
        if l.focus:
            print(f"{' ' * name_w}          {C.b}focus{C.x}")
