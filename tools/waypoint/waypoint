def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="waypoint",
        description="Manage shell navigational shortcuts ($VAR exports + `wp` jump function).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "--shell-file",
        default=None,
        help="Override the shell login file to manage (default: auto-detect, honouring $WAYPOINT_SHELL_FILE).",
    )
    p.add_argument(
        "--machine",
        default=None,
        help="Override this machine's identity (default: auto-detect, honouring $WAYPOINT_MACHINE, then "
             "the OS hostname). For `add`/`remove` this instead sets which machine-scoped row to act on "
             "(default: universal/blank). Must appear before the subcommand, e.g. "
             "`waypoint --machine work-laptop list`.",
    )
    sub = p.add_subparsers(dest="command", required=True)

    sp = sub.add_parser("add", help="Add or update a waypoint, then sync.")
    sp.add_argument("name", help="Shortcut name (becomes $NAME and `wp name`).")
    sp.add_argument("path", help="Directory path (~ and $VARS allowed).")
    sp.add_argument("--note", default=None, help="Optional note stored in the database.")
    sp.add_argument("--force", action="store_true", help="Override a blocked name.")
    sp.set_defaults(func=cmd_add)

    sp = sub.add_parser("remove", help="Remove a waypoint, then sync.")
    sp.add_argument("name", help="Name of the waypoint to remove.")
    sp.set_defaults(func=cmd_remove)

    sp = sub.add_parser("block", help="Record a name as a deliberate exclusion (never exported).")
    sp.add_argument("name", help="Name to block.")
    sp.add_argument("path", nargs="?", default=None, help="Optional path to remember with the block.")
    sp.add_argument("--note", default=None, help="Optional note.")
    sp.set_defaults(func=cmd_block)

    sp = sub.add_parser("unblock", help="Lift a block, making the name active again.")
    sp.add_argument("name", help="Name to unblock.")
    sp.set_defaults(func=cmd_unblock)

    sp = sub.add_parser("list", help="List tracked waypoints with existence check.")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("sync", help="Regenerate the managed block from the database.")
    sp.set_defaults(func=cmd_sync)

    sp = sub.add_parser("doctor", help="Verify the database and every tracked path.")
    sp.set_defaults(func=cmd_doctor)

    sp = sub.add_parser("import", help="Rebuild the database from the shell file's managed block.")
    sp.add_argument("--force", action="store_true", help="Overwrite an existing database.")
    sp.set_defaults(func=cmd_import)

    sp = sub.add_parser("install", help="Ensure the managed block exists (creates empty db if needed).")
    sp.set_defaults(func=cmd_install)

    sp = sub.add_parser("uninstall", help="Remove the managed block from the shell file (keeps db).")
    sp.set_defaults(func=cmd_uninstall)

    sp = sub.add_parser("path", help="Print resolved shell-file, database, and backup paths.")
    sp.set_defaults(func=cmd_path)

    sp = sub.add_parser("machine", help="Print this machine's resolved identity key.")
    sp.set_defaults(func=cmd_machine)

    # Launch aliases: a parallel managed block + `launch <name>` shell function.
    lp = sub.add_parser("launch", help="Manage launch aliases (cd into a dir + run a command).")
    lsub = lp.add_subparsers(dest="launch_command", required=True)

    la = lsub.add_parser("add", help="Add or update a launch alias, then sync.")
    la.add_argument("name", help="Alias name (becomes `launch name`; substituted for {NAME}).")
    la.add_argument("--waypoint", default=None, help="Waypoint to cd into (preferred; follows its per-machine path).")
    la.add_argument("--path", default=None, help="Explicit directory (used only if --waypoint is omitted).")
    la.add_argument("--cmd", default=None, help="Command to run; omit to use the default template.")
    la.add_argument("--note", default=None, help="Optional note stored in the database.")
    la.set_defaults(func=cmd_launch_add)

    lr = lsub.add_parser("remove", help="Remove a launch alias, then sync.")
    lr.add_argument("name", help="Alias to remove.")
    lr.set_defaults(func=cmd_launch_remove)

    ll = lsub.add_parser("list", help="List launch aliases with resolved dir and command.")
    ll.set_defaults(func=cmd_launch_list)

    lt = lsub.add_parser("template", help="Show or set the default command template.")
    lt.add_argument("template", nargs="?", default=None,
                    help="New template (with {NAME}/{DIR}); omit to print the current one.")
    lt.set_defaults(func=cmd_launch_template)

    # Focus: a marker on launch rows + a bulk "open what's missing" in iTerm2.
    fp = sub.add_parser("focus", help="Manage current-focus launches and open the missing ones in iTerm2.")
    fsub = fp.add_subparsers(dest="focus_command", required=True)

    fa = fsub.add_parser("add", help="Mark a launch alias as current focus (all its machine rows, "
                                     "or only the global --machine row).")
    fa.add_argument("name", help="Launch alias name.")
    fa.set_defaults(func=cmd_focus_add)

    fr = fsub.add_parser("remove", help="Clear the focus marker (does not remove the launch alias).")
    fr.add_argument("name", help="Launch alias name.")
    fr.set_defaults(func=cmd_focus_remove)

    fl = fsub.add_parser("list", help="List focus launches and where they resolve on this machine.")
    fl.set_defaults(func=cmd_focus_list)

    fo = fsub.add_parser("launch", help="Open an iTerm2 window for every focus launch not already open.")
    fo.add_argument("--dry-run", action="store_true", help="Report what would open; open nothing.")
    fo.add_argument("--only", action="append", metavar="NAME",
                    help="Consider only this focus launch (repeatable).")
    fo.add_argument("--arrange", action="store_true",
                    help="Afterwards run `layout apply`, moving reused/restored windows to their saved "
                    "Space and bounds (drives the mouse for a few seconds per misplaced window).")
    fo.set_defaults(func=cmd_focus_launch)

    # Layouts: per-machine Space + bounds of each focus window (layouts.md).
    yp = sub.add_parser("layout", help="Save/show each focus window's Space and bounds (restored by focus launch).")
    ysub = yp.add_subparsers(dest="layout_command")
    yp.set_defaults(func=cmd_layout_show)

    ys = ysub.add_parser("save", help="Record the Space + bounds of every open focus window on this machine.")
    ys.set_defaults(func=cmd_layout_save)

    ysh = ysub.add_parser("show", help="Print this machine's saved layouts (the default).")
    ysh.set_defaults(func=cmd_layout_show)

    yf = ysub.add_parser("forget", help="Drop one project's saved layout on this machine.")
    yf.add_argument("name", help="Launch alias name.")
    yf.set_defaults(func=cmd_layout_forget)

    ya = ysub.add_parser("apply", help="Put every open focus window back on its saved Space and bounds "
                         "(after iTerm2 restarts). Moves the mouse and takes over the machine for a few "
                         "seconds per window.",
                         description="Moves each already-open focus window to its saved Space and bounds. "
                         "It switches Spaces, drives the mouse (uimovespace) and takes over the machine for "
                         "a few seconds per misplaced window. Windows already correct are untouched.")
    ya.add_argument("--dry-run", action="store_true", help="Print the plan; touch nothing.")
    ya.add_argument("--only", action="append", metavar="NAME", help="Consider only this focus launch (repeatable).")
    ya.set_defaults(func=cmd_layout_apply)

    ypr = ysub.add_parser("profiles", help=f"(Re)write the {SPACE_PROFILE_PREFIX}N iTerm2 dynamic profiles.")
    ypr.add_argument("--count", type=int, default=None, help="How many (default: this machine's desktop count).")
    ypr.set_defaults(func=cmd_layout_profiles)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
