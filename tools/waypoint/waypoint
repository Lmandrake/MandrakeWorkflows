#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
waypoint — a tiny navigational-shortcut manager for the shell.
================================================================

WHAT IT DOES
------------
Waypoint keeps a curated list of "project root" directories and exposes each one
to your shell in two ways:

  1. As an environment variable, e.g.  $NOTES  ->  /home/you/dev/Notes_v2
  2. As a jump target for the `wp` function, e.g.  `wp notes`  ->  cd's you there.

It does this by writing a single, clearly-labelled, self-managed block into your
shell login file (default: ~/.zshrc). Waypoint owns that block exclusively and
rewrites it wholesale on every `sync`. Nothing outside the block is ever touched.

THE SOURCE OF TRUTH IS THE DATABASE, NOT THE SHELL FILE
-------------------------------------------------------
Waypoint's authoritative record of what it tracks is a human-readable Markdown
table at:

    $WAYPOINT_DATA/waypoints.md   (default ~/.config/waypoint/waypoints.md)

Everything Waypoint renders into your shell file is derived from that database.
This separation is deliberate and gives you two independent recovery paths:

  * If your ~/.zshrc gets corrupted or clobbered:   `waypoint sync`
        -> rebuilds the managed block exactly from waypoints.md.

  * If waypoints.md is ever lost or damaged:        `waypoint import`
        -> reconstructs the database by reading the managed block back out of
           your shell file.

So the two artifacts back each other up. As long as either survives, the other
can be regenerated.

DESIGN PRINCIPLES
-----------------
  * Idempotent:  re-running `sync` with an unchanged database produces a
                 byte-for-byte identical managed block.
  * Non-destructive:  the shell login file is backed up (timestamped, into
                 <data dir>/backups/) before every modification.
  * Surgical:  only the region between the BEGIN/END sentinels is ever replaced.
                 Your own aliases, functions, and settings are left alone.
  * Warn-but-export:  if a tracked directory no longer exists on disk, Waypoint
                 STILL defines the variable (so the name keeps working if the
                 path returns) but prints a warning. `waypoint doctor` reports
                 every missing path.
  * Zero dependencies:  standard-library Python 3 only. No pip installs.

COMMANDS  (run `waypoint <command> -h` for details on each)
-----------------------------------------------------------
  add NAME PATH [--note ...] [--machine M]  Add or update a waypoint, then sync.
  remove NAME [--machine M]   Remove a waypoint (all machines, or just one), then sync.
  list                        Show tracked waypoints (with existence check).
  sync                        Regenerate the managed block from the database.
  doctor                      Verify the database and every tracked path.
  import                      Rebuild the database from the shell file's block.
  install                     Ensure the managed block exists in the shell file.
  uninstall                   Remove the managed block from the shell file.
  path                        Print the resolved shell-file and database paths.
  machine                     Print this machine's resolved identity key.
  launch add|remove|list|template   Manage `launch <name>` aliases (launches.md).
  focus add|remove NAME       Mark/unmark a launch alias as current focus.
  focus list                  Show focus launches and where they resolve here.
  focus launch [--dry-run] [--only NAME] [--arrange]   Start iTerm2 if needed; open a window per
                              focus launch not already open (reusing a restored idle window
                              titled for it), on its saved Space/bounds when layouts.md has a
                              row. --arrange then runs `layout apply` on the reused ones.
  layout [show|save|forget NAME|profiles]  Per-machine window Space + bounds (layouts.md).

MULTI-MACHINE SCOPING
----------------------
Keep the data directory in a private synced repo (symlink ~/.config/waypoint into it)
and the same tables reach every machine you use. Each
row has an optional Machine column: blank means "universal fallback," used by any
machine with no more specific row for that Name. Give `--machine NAME` BEFORE the
subcommand to override this machine's identity for a `list`/`doctor`/`sync` run,
or to scope an `add`/`remove` to one particular machine instead of the default
universal row. Run `waypoint machine` to see this machine's own resolved key.

After any command that changes your shell file, open a new terminal (or run
`source ~/.zshrc`) for the changes to take effect.

See README.md for the tour.
"""

from __future__ import annotations

import argparse
import datetime as _dt
import json
import os
import plistlib
import re
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path

# --------------------------------------------------------------------------- #
# Constants
# --------------------------------------------------------------------------- #

# Where this script lives, and where its databases live. They are separate on purpose: the
# tool is shareable code, the tables are one person's private map of their disk. The data
# directory is $WAYPOINT_DATA if set, else ~/.config/waypoint (which may be a symlink into a
# private synced repo, so every machine shares one set of tables). `waypoint install` creates
# it, and links this executable into it as `waypoint` so other tools find the CLI beside its
# data.
HERE = Path(__file__).resolve().parent
DATA_DIR = Path(os.path.expanduser(os.environ.get("WAYPOINT_DATA") or "~/.config/waypoint"))
DB_PATH = DATA_DIR / "waypoints.md"
BACKUP_DIR = DATA_DIR / "backups"

# The sentinels that fence off Waypoint's exclusive territory in the shell file.
# `sync` replaces everything between these two lines (inclusive). Text outside
# them is never modified. Do not change these strings casually: existing managed
# blocks are located by matching them literally.
BEGIN = "# >>> waypoint (managed — do not edit by hand) >>>"
END = "# <<< waypoint (managed) <<<"

# Launch aliases live in a SECOND managed block, rendered in parallel to the
# waypoints block above. It defines a `launch <name>` shell function that cds
# into a directory and runs a command (e.g. start a Claude session in a project
# root). Its source of truth is launches.md, beside waypoints.md.
LAUNCH_DB_PATH = DATA_DIR / "launches.md"
LAUNCH_BEGIN = "# >>> waypoint-launch (managed — do not edit by hand) >>>"
LAUNCH_END = "# <<< waypoint-launch (managed) <<<"

# The default command a launch alias runs unless it sets its own. Tokens {NAME}
# and {DIR} are substituted per alias. Overridable per-database via a "Default
# launch template:" line in launches.md.
DEFAULT_LAUNCH_TEMPLATE = "claude --dangerously-skip-permissions -n {NAME}"

# A variable name must be a valid POSIX shell identifier so that `export NAME=...`
# is legal. We render names in UPPER_CASE by convention.
VALID_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")

# ANSI colours (suppressed automatically when output is not a TTY).
class _C:
    def __init__(self, enabled: bool):
        self.g = "\033[32m" if enabled else ""   # green  (ok)
        self.y = "\033[33m" if enabled else ""    # yellow (warn)
        self.r = "\033[31m" if enabled else ""    # red    (error)
        self.b = "\033[34m" if enabled else ""    # blue   (info)
        self.d = "\033[2m" if enabled else ""     # dim
        self.x = "\033[0m" if enabled else ""     # reset

C = _C(sys.stdout.isatty())


# --------------------------------------------------------------------------- #
# Small helpers
# --------------------------------------------------------------------------- #

def _now_stamp() -> str:
    """Filesystem-safe timestamp for backup filenames."""
    return _dt.datetime.now().strftime("%Y-%m-%d_%H%M%S")


def _iso_today() -> str:
    """Human date recorded in the database when a waypoint is added."""
    return _dt.date.today().isoformat()


def info(msg: str) -> None:
    print(f"{C.b}•{C.x} {msg}")


def ok(msg: str) -> None:
    print(f"{C.g}✓{C.x} {msg}")


def warn(msg: str) -> None:
    print(f"{C.y}⚠{C.x} {msg}")


def err(msg: str) -> None:
    print(f"{C.r}✗{C.x} {msg}", file=sys.stderr)


def die(msg: str, code: int = 1) -> "NoReturn":  # type: ignore[name-defined]
    err(msg)
    sys.exit(code)


def expand(path: str) -> str:
    """Expand ~ and environment variables, returning an absolute path string.

    We store absolute, tilde-free paths in the database so the record is
    unambiguous, but we accept ~ and $VARS on input for convenience.
    """
    return str(Path(os.path.expandvars(os.path.expanduser(path))).resolve(strict=False))


def current_machine(override: str | None = None) -> str:
    """Resolve this machine's identity key for per-machine waypoint rows.

    Precedence: an explicit --machine CLI override, then $WAYPOINT_MACHINE (set
    by hand outside the managed block — useful because corporate-imaged Macs
    often have an asset-tag hostname like 'MT-ABC123' rather than something
    readable, and that tag can change on a re-image), then the OS hostname
    itself, normalized (lowercased, trailing '.local' stripped).
    """
    raw = override or os.environ.get("WAYPOINT_MACHINE") or socket.gethostname()
    raw = raw.strip()
    if raw.lower().endswith(".local"):
        raw = raw[: -len(".local")]
    return raw.lower()


# --------------------------------------------------------------------------- #
# Shell-quoting
# --------------------------------------------------------------------------- #

def sh_squote(value: str) -> str:
    """Single-quote a string safely for POSIX sh/zsh.

    Single quotes preserve everything literally except a single quote itself,
    which we emit using the classic '\\'' escape. This makes paths containing
    spaces, parentheses, and other metacharacters safe in `export VAR=...`.
    """
    return "'" + value.replace("'", "'\\''") + "'"


# --------------------------------------------------------------------------- #
# Shell-file resolution
# --------------------------------------------------------------------------- #

def default_shell_file() -> Path:
    """Choose the login file to manage.

    Order of precedence:
      1. $WAYPOINT_SHELL_FILE  (explicit override, honoured everywhere)
      2. ~/.zshrc if the current shell looks like zsh OR the file already exists
      3. ~/.bashrc as a fallback for bash users

    NOTE: the `wp` jump function is a *shell function*, and functions (unlike
    exported variables) are NOT inherited by child shells. They must therefore
    live in a file that every interactive shell sources — which is ~/.zshrc for
    zsh (the macOS default) and ~/.bashrc for bash. That is why we target the
    interactive rc file rather than a login-only profile.
    """
    override = os.environ.get("WAYPOINT_SHELL_FILE")
    if override:
        return Path(expand(override))

    home = Path.home()
    shell = os.environ.get("SHELL", "")
    zshrc = home / ".zshrc"
    bashrc = home / ".bashrc"

    if "zsh" in shell or zshrc.exists():
        return zshrc
    if "bash" in shell or bashrc.exists():
        return bashrc
    # Default to zsh on modern macOS.
    return zshrc


# --------------------------------------------------------------------------- #
# Database (Markdown) read/write
# --------------------------------------------------------------------------- #
#
# The database is a GitHub-flavoured Markdown document with a single table:
#
#   | Name | Path | Added | Status | Notes |
#   |------|------|-------|--------|-------|
#   | NOTES | /abs/path | 2026-08-17 | active | ... |
#
# We parse only that table. Prose above/below the table is preserved on rewrite
# via a fixed header/footer template, so the file always stays readable.
# --------------------------------------------------------------------------- #

class Waypoint:
    """One tracked shortcut.

    `machine` is optional. Blank means "universal fallback": this row applies on
    any machine that has no more specific row for the same `name`. A `name` may
    have multiple rows as long as each has a distinct `machine` (at most one of
    which is blank) — see resolve_for_machine().
    """

    __slots__ = ("name", "path", "added", "status", "notes", "machine")

    def __init__(self, name: str, path: str, added: str = "", status: str = "active", notes: str = "",
                 machine: str = ""):
        self.name = name
        self.path = path
        self.added = added or _iso_today()
        self.status = status or "active"
        self.notes = notes or ""
        self.machine = machine or ""

    def exists(self) -> bool:
        return Path(self.path).is_dir()


DB_HEADER = """\
# Waypoints — navigational shortcuts database

This file is the **authoritative source of truth** for the `waypoint` tool.
Every environment variable and `wp` jump target in your shell is rendered from
the table below. Edit here (or via `waypoint add` / `waypoint remove`) and then
run `waypoint sync` to push changes into your shell login file.

If your shell login file is ever damaged, `waypoint sync` rebuilds it from this
table. If *this* file is ever lost, `waypoint import` rebuilds it from the
managed block in your shell login file.

Columns:
- **Name** — the shortcut name; becomes `$NAME` and `wp name`. Must be a valid
  shell identifier (letters, digits, underscore; not starting with a digit).
- **Path** — absolute directory path (no `~`).
- **Added** — date the waypoint was first recorded.
- **Status** — `active` normally; free-form otherwise (e.g. `stale`).
- **Notes** — optional human note.
- **Machine** — optional. Blank = universal fallback, used on any machine with
  no more specific row for this Name. A Name may have several rows as long as
  each has a distinct Machine (see `waypoint machine` to find this machine's
  key, and the README for the full resolution rule).

| Name | Path | Added | Status | Notes | Machine |
|------|------|-------|--------|-------|---------|
"""

DB_FOOTER = """
<!-- Managed by waypoint. You may edit the table by hand; keep the header row
     and the separator row intact, then run `waypoint sync`. -->
"""


def load_db() -> list[Waypoint]:
    """Read and parse the Markdown database. Returns [] if it doesn't exist."""
    if not DB_PATH.exists():
        return []

    rows: list[Waypoint] = []
    in_table = False
    seen_separator = False

    for raw in DB_PATH.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line.startswith("|"):
            # A non-table line ends the table region once we've been inside it.
            if in_table:
                in_table = False
            continue

        cells = [c.strip() for c in line.strip("|").split("|")]

        # Detect the header row and the |---|---| separator row and skip them.
        lowered = [c.lower() for c in cells]
        if lowered[:2] == ["name", "path"]:
            in_table = True
            seen_separator = False
            continue
        if in_table and not seen_separator and set("".join(cells)) <= set("-: "):
            seen_separator = True
            continue

        if in_table and seen_separator:
            # Pad short rows so optional trailing columns (including the newer
            # Machine column) are tolerated.
            while len(cells) < 6:
                cells.append("")
            name, path, added, status, notes, machine = cells[:6]
            if not name:
                continue
            rows.append(Waypoint(name=name, path=path, added=added, status=status, notes=notes,
                                  machine=machine))

    return rows


def save_db(waypoints: list[Waypoint]) -> None:
    """Write the database back out, sorted by (name, machine) for stable diffs."""
    waypoints = sorted(waypoints, key=lambda w: (w.name.upper(), w.machine.lower()))
    lines = [DB_HEADER.rstrip("\n")]
    for w in waypoints:
        # Escape any pipe characters that might appear in notes/paths.
        def esc(s: str) -> str:
            return s.replace("|", "\\|")
        lines.append(
            f"| {esc(w.name)} | {esc(w.path)} | {esc(w.added)} | {esc(w.status)} | {esc(w.notes)} | {esc(w.machine)} |"
        )
    lines.append(DB_FOOTER)
    DB_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")


# --------------------------------------------------------------------------- #
# Launch aliases (second database: launches.md)
# --------------------------------------------------------------------------- #
#
# A launch alias binds a name to a directory + a command. The directory comes
# either from an existing waypoint (preferred — so it follows that waypoint's
# per-machine resolution automatically) or from an explicit path. The command
# is the shared default template unless the alias overrides it.
# --------------------------------------------------------------------------- #

class Launch:
    """One launch alias.

    Exactly one of `waypoint` (a waypoint name to cd into) or `path` (an explicit
    directory) provides the working directory; `waypoint` is preferred because it
    inherits that waypoint's multi-machine resolution. `command` blank means "use
    the database's default template". `machine` scoping mirrors Waypoint.
    """

    __slots__ = ("name", "waypoint", "path", "command", "added", "status", "notes", "machine", "focus")

    def __init__(self, name: str, waypoint: str = "", path: str = "", command: str = "",
                 added: str = "", status: str = "active", notes: str = "", machine: str = "",
                 focus: bool = False):
        self.name = name
        self.waypoint = waypoint or ""
        self.path = path or ""
        self.command = command or ""
        self.added = added or _iso_today()
        self.status = status or "active"
        self.notes = notes or ""
        self.machine = machine or ""
        self.focus = bool(focus)


FOCUS_TRUE = {"yes", "y", "true", "1", "x"}


def parse_focus(cell: str) -> bool:
    return cell.strip().lower() in FOCUS_TRUE


LAUNCH_TEMPLATE_LABEL = "Default launch template:"

LAUNCH_DB_HEADER_TMPL = """\
# Launch aliases database

This file is the **authoritative source of truth** for `waypoint`'s launch
aliases — the second managed block in your shell file, which defines a
`launch <name>` function that cds into a directory and runs a command (for
example, starting a Claude session in a project root). Edit here (or via
`waypoint launch add` / `waypoint launch remove`) then run `waypoint sync`.

{label} {template}

Columns:
- **Name** — the alias; becomes `launch name`. Also substituted for `{{NAME}}`
  in the command template (verbatim casing). Must be a valid shell identifier.
- **Waypoint** — name of a waypoint to cd into (preferred; follows that
  waypoint's per-machine resolution). Leave blank to use Path instead.
- **Path** — an explicit absolute directory, used only when Waypoint is blank.
- **Command** — the command to run; blank means use the default template above.
  `{{NAME}}` and `{{DIR}}` are substituted. Colour markers: the text colour is
  `printf '\\033]10;#RRGGBB\\007'` (iTerm2 foreground; Lodestar colorboard.py
  reads it); an optional `: led=#RRGGBB;` right after it is the project's
  SidePulse LED colour (a shell no-op; absent means the LED uses the text hex).
- **Added** / **Status** / **Notes** — as in waypoints.md.
- **Machine** — optional; blank = universal fallback (same rule as waypoints).
- **Focus** — `yes` marks a current-focus project: `waypoint focus launch`
  opens an iTerm2 window for it if none is open. Blank = not in focus. Purely a
  launcher marker; it has no effect on Lodestar's background sync.

| Name | Waypoint | Path | Command | Added | Status | Notes | Machine | Focus |
|------|----------|------|---------|-------|--------|-------|---------|-------|
"""

LAUNCH_DB_FOOTER = """
<!-- Managed by waypoint. You may edit the table by hand; keep the header row
     and the separator row intact, then run `waypoint sync`. -->
"""


def load_launch_template() -> str:
    """Read the default command template from launches.md, or the built-in default."""
    if not LAUNCH_DB_PATH.exists():
        return DEFAULT_LAUNCH_TEMPLATE
    for raw in LAUNCH_DB_PATH.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if line.startswith(LAUNCH_TEMPLATE_LABEL):
            return line[len(LAUNCH_TEMPLATE_LABEL):].strip() or DEFAULT_LAUNCH_TEMPLATE
    return DEFAULT_LAUNCH_TEMPLATE


def load_launches() -> list[Launch]:
    """Read and parse launches.md. Returns [] if it doesn't exist."""
    if not LAUNCH_DB_PATH.exists():
        return []

    rows: list[Launch] = []
    in_table = False
    seen_separator = False

    for raw in LAUNCH_DB_PATH.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line.startswith("|"):
            if in_table:
                in_table = False
            continue

        cells = [c.strip() for c in line.strip("|").split("|")]
        lowered = [c.lower() for c in cells]
        if lowered[:2] == ["name", "waypoint"]:
            in_table = True
            seen_separator = False
            continue
        if in_table and not seen_separator and set("".join(cells)) <= set("-: "):
            seen_separator = True
            continue

        if in_table and seen_separator:
            while len(cells) < 9:
                cells.append("")
            name, waypoint, path, command, added, status, notes, machine, focus = cells[:9]
            if not name:
                continue
            rows.append(Launch(name=name, waypoint=waypoint, path=path, command=command,
                               added=added, status=status, notes=notes, machine=machine,
                               focus=parse_focus(focus)))

    return rows


def save_launches(launches: list[Launch], template: str | None = None) -> None:
    """Write launches.md back out, sorted by (name, machine) for stable diffs."""
    if template is None:
        template = load_launch_template()
    launches = sorted(launches, key=lambda l: (l.name.upper(), l.machine.lower()))
    header = LAUNCH_DB_HEADER_TMPL.format(label=LAUNCH_TEMPLATE_LABEL, template=template)
    lines = [header.rstrip("\n")]

    def esc(s: str) -> str:
        return s.replace("|", "\\|")

    for l in launches:
        lines.append(
            f"| {esc(l.name)} | {esc(l.waypoint)} | {esc(l.path)} | {esc(l.command)} | "
            f"{esc(l.added)} | {esc(l.status)} | {esc(l.notes)} | {esc(l.machine)} | "
            f"{'yes' if l.focus else ''} |"
        )
    lines.append(LAUNCH_DB_FOOTER)
    LAUNCH_DB_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")


# --------------------------------------------------------------------------- #
# Rendering the managed block
# --------------------------------------------------------------------------- #

def is_blocked(w: "Waypoint") -> bool:
    """A waypoint whose status is 'blocked' is a deliberate exclusion.

    Blocked entries are RECORDED in the database (so the decision persists and
    neither the tool nor a human re-adds them by accident) but are NEVER
    rendered into the shell file — no export, no jump target.
    """
    return w.status.strip().lower() == "blocked"


def resolve_for_machine(waypoints: list[Waypoint], machine: str) -> list[Waypoint]:
    """Pick exactly one row per Name for the given machine.

    Per Name: an exact (case-insensitive) Machine match wins; otherwise the
    blank/wildcard row (if any) is used as a universal fallback; otherwise this
    Name simply has nothing to offer on this machine and is omitted — that is
    not an error, just "not tracked here."

    Blocked rows are excluded up front so a block always wins regardless of
    machine scoping.
    """
    by_name: dict[str, list[Waypoint]] = {}
    for w in waypoints:
        if is_blocked(w):
            continue
        by_name.setdefault(w.name.upper(), []).append(w)

    winners: list[Waypoint] = []
    machine_lower = machine.lower()
    for rows in by_name.values():
        exact = next((w for w in rows if w.machine.lower() == machine_lower), None)
        chosen = exact or next((w for w in rows if not w.machine), None)
        if chosen is not None:
            winners.append(chosen)
    return winners


def render_block(waypoints: list[Waypoint], machine: str = "") -> str:
    """Produce the exact text of the managed block (between the sentinels).

    Resolves one row per Name for `machine` first (see resolve_for_machine), so
    the rendered block only ever contains what this machine should see. The
    output is deterministic: an unchanged database + machine always renders
    identical bytes (idempotency guarantee).
    """
    wps = sorted(resolve_for_machine(waypoints, machine), key=lambda w: w.name.upper())

    lines: list[str] = [BEGIN]
    lines.append("# Generated by waypoint. Do not edit inside these markers by hand;")
    lines.append("# your edits will be overwritten on the next `waypoint sync`.")
    lines.append(f"# Source of truth: {DB_PATH}")
    lines.append(f"# Rendered for machine: {machine}")
    lines.append("#")

    if not wps:
        lines.append("# (no waypoints defined yet)")
    else:
        # 1) Environment-variable exports, under the canonical UPPERCASE name.
        for w in wps:
            lines.append(f"export {w.name.upper()}={sh_squote(w.path)}")

        # 1b) Shell variables cannot be case-insensitive, so the other spellings
        #     people actually type ($thesis, $Thesis, the DB's own casing) are
        #     plain (unexported) shell variables, kept out of child environments.
        aliases = [(a, w) for w in wps for a in case_aliases(w.name)]
        if aliases:
            lines.append("")
            lines.append("# Case variants of the names above ($thesis, $Thesis): shell-only, not exported.")
            for a, w in aliases:
                lines.append(f"{a}={sh_squote(w.path)}")

        # 2) A name->path lookup used by the `wp` jump function. We build it as a
        #    portable case statement so it works in both zsh and bash without
        #    associative-array syntax differences.
        lines.append("")
        lines.append("# wp <name>: jump (cd) to a waypoint's root directory.")
        lines.append("# `wp` with no argument lists the available names.")
        lines.append("wp() {")
        lines.append("  local _wp_target _wp_key")
        lines.append("  if [ -z \"$1\" ]; then")
        names_display = " ".join(w.name.lower() for w in wps)
        lines.append(f"    echo \"waypoints: {names_display}\"")
        lines.append("    return 0")
        lines.append("  fi")
        # Fold the argument to lowercase so matching is fully case-insensitive.
        # bash and zsh share no portable in-shell lowercase operator, so we shell
        # out to tr; the case labels below are all lowercase to match.
        lines.append("  _wp_key=$(printf '%s' \"$1\" | tr '[:upper:]' '[:lower:]')")
        lines.append("  case \"$_wp_key\" in")
        # Each arm also answers to its folder's name (`wp rimmandrake` for
        # RIMMASTER -> .../RimMandrake), unless that is another waypoint's name.
        taken = {w.name.lower() for w in wps}
        for w in wps:
            pat = w.name.lower()
            base = Path(w.path.rstrip("/")).name.lower()
            if base != pat and base not in taken and VALID_NAME.match(base):
                taken.add(base)
                pat = f"{pat}|{base}"
            lines.append(f"    {pat}) _wp_target={sh_squote(w.path)} ;;")
        lines.append("    *) echo \"wp: unknown waypoint '$1'\" >&2; return 1 ;;")
        lines.append("  esac")
        lines.append("  cd \"$_wp_target\" || return 1")
        lines.append("}")

    lines.append(END)
    return "\n".join(lines)


# Lowercase parameter names zsh/bash already own; a waypoint alias must never
# assign one (e.g. `path=...` would clobber zsh's $PATH array).
SHELL_RESERVED = frozenset("""
    path fpath cdpath manpath mailpath module_path psvar watch status pipestatus
    argv prompt prompt2 prompt3 prompt4 histchars signals options parameters
    commands functions aliases builtins modules history historywords dirstack
    nameddirs userdirs funcstack funcfiletrace funcsourcetrace termcap terminfo
    mapfile reswords saliases galiases keymaps widgets jobstates jobtexts jobdirs
    sysparams errnos epochtime zsh_eval_context zsh_scheduled_events match mbegin
    mend reply
""".split())


def case_aliases(name: str) -> list[str]:
    """Non-canonical spellings of a waypoint name to define as shell variables.

    lowercase, Capitalized and the DB's verbatim casing, minus the canonical
    UPPERCASE export and anything a shell reserves.
    """
    out: list[str] = []
    for a in (name.lower(), name[:1].upper() + name[1:].lower(), name):
        if a != name.upper() and a not in out and a.lower() not in SHELL_RESERVED:
            out.append(a)
    return out


def resolve_launch_dir(launch: "Launch", wp_paths: dict[str, str]) -> str | None:
    """The directory a launch should cd into on this machine, or None if unavailable.

    A waypoint reference is resolved against `wp_paths` (name.upper() -> path,
    already resolved for this machine). If the referenced waypoint isn't tracked
    here, the launch simply can't run on this machine and is skipped — not an
    error, consistent with how a machine-scoped waypoint is skipped elsewhere. An
    explicit path is used as-is.
    """
    if launch.waypoint:
        return wp_paths.get(launch.waypoint.upper())
    if launch.path:
        return launch.path
    return None


def render_launch_template(template: str, name: str, directory: str) -> str:
    """Substitute the {NAME}/{DIR} tokens in a launch command template."""
    return template.replace("{NAME}", name).replace("{DIR}", directory)


def render_launch_block(launches: list[Launch], waypoints: list[Waypoint],
                        machine: str = "", template: str | None = None) -> str:
    """Produce the exact text of the launch managed block (between its sentinels).

    Deterministic like render_block: same databases + machine -> identical bytes.
    Launches whose directory can't be resolved on this machine are omitted.
    """
    if template is None:
        template = DEFAULT_LAUNCH_TEMPLATE
    wp_paths = {w.name.upper(): w.path for w in resolve_for_machine(waypoints, machine)}
    chosen = sorted(resolve_for_machine(launches, machine), key=lambda l: l.name.upper())

    # Pair each renderable launch with its resolved (dir, command).
    entries: list[tuple[Launch, str, str]] = []
    for l in chosen:
        directory = resolve_launch_dir(l, wp_paths)
        if directory is None:
            continue
        command = render_launch_template(l.command or template, l.name, directory)
        entries.append((l, directory, command))

    lines: list[str] = [LAUNCH_BEGIN]
    lines.append("# Generated by waypoint. Do not edit inside these markers by hand;")
    lines.append("# your edits will be overwritten on the next `waypoint sync`.")
    lines.append(f"# Source of truth: {LAUNCH_DB_PATH}")
    lines.append(f"# Rendered for machine: {machine}")
    lines.append("#")

    if not entries:
        lines.append("# (no launch aliases defined yet)")
    else:
        lines.append("# launch <name>: cd into a project and run its command.")
        lines.append("# `launch` with no argument lists the available names.")
        lines.append("launch() {")
        lines.append("  local _launch_key")
        lines.append("  if [ -z \"$1\" ]; then")
        names_display = " ".join(l.name.lower() for l, _, _ in entries)
        lines.append(f"    echo \"launches: {names_display}\"")
        lines.append("    return 0")
        lines.append("  fi")
        # Case-insensitive match, same tr-based lowercase fold as wp().
        lines.append("  _launch_key=$(printf '%s' \"$1\" | tr '[:upper:]' '[:lower:]')")
        lines.append("  case \"$_launch_key\" in")
        for l, directory, command in entries:
            pat = l.name.lower()
            # The directory is single-quoted (it's data); the command is embedded
            # literally (it's meant to be executed as the user wrote it).
            lines.append(f"    {pat}) cd {sh_squote(directory)} && {command} ;;")
        lines.append("    *) echo \"launch: unknown alias '$1'\" >&2; return 1 ;;")
        lines.append("  esac")
        lines.append("}")

    lines.append(LAUNCH_END)
    return "\n".join(lines)


# --------------------------------------------------------------------------- #
# Shell-file editing (backup + surgical block replacement)
# --------------------------------------------------------------------------- #

def backup_shell_file(shell_file: Path) -> Path | None:
    """Copy the shell file into ./backups/, stamped with machine + time.

    The machine key is part of the filename because backups/ lives beside the
    database — i.e. on shared cloud storage visible to every machine. Without it,
    two machines syncing in the same second would collide, and (far worse) you
    could not tell whose ~/.zshrc a given backup is a snapshot of, which makes it
    unsafe to restore from. We deliberately use the *physical* machine identity
    here (no --machine override): a backup records where the file came from, not
    whichever machine's view was being rendered.
    """
    if not shell_file.exists():
        return None
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    dest = BACKUP_DIR / f"{shell_file.name}.{current_machine()}.{_now_stamp()}.bak"
    shutil.copy2(shell_file, dest)
    return dest


def find_all_blocks(text: str, begin: str = BEGIN, end: str = END) -> list[tuple[int, int]]:
    """Return (start, end) spans for EVERY managed block of the given kind.

    We scan for all begin…end pairs, not just the first. This is what makes the
    tool self-healing: if a previous bug (or a hand-edit) ever left more than one
    managed block in the file, the next write collapses them all into one.
    Unmatched/half blocks (a begin with no following end) are ignored so we never
    delete arbitrary user content.
    """
    spans: list[tuple[int, int]] = []
    pos = 0
    while True:
        b = text.find(begin, pos)
        if b == -1:
            break
        e = text.find(end, b)
        if e == -1:
            break  # dangling begin with no end: leave it alone
        e_end = e + len(end)
        spans.append((b, e_end))
        pos = e_end
    return spans


def extract_block(text: str, begin: str = BEGIN, end: str = END) -> str | None:
    """Return the FIRST managed block body (between sentinels) or None."""
    spans = find_all_blocks(text, begin, end)
    if not spans:
        return None
    b, e = spans[0]
    return text[b:e]


def count_blocks(text: str, begin: str = BEGIN, end: str = END) -> int:
    return len(find_all_blocks(text, begin, end))


def _apply_block(text: str, block: str, begin: str = BEGIN, end: str = END) -> tuple[str, str]:
    """Pure string transform: insert/replace/dedupe one kind of block in `text`.

    Replaces the FIRST matching block in place and REMOVES any additional ones,
    guaranteeing exactly one block of this kind afterward (self-healing against
    duplicates). If none exist, appends a fresh block at the end. Returns
    (new_text, action) where action is created/updated/deduped+updated/unchanged.
    """
    spans = find_all_blocks(text, begin, end)
    if spans:
        first_start, first_end = spans[0]
        head = text[:first_start]
        tail = text[first_end:]
        for b, e in reversed(spans[1:]):
            tail = tail[: b - first_end] + tail[e - first_end :]
        new_text = head + block + tail
        action = "deduped+updated" if len(spans) > 1 else "updated"
    else:
        sep = "" if text == "" or text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
        new_text = text + sep + block + "\n"
        action = "created"
    if new_text == text:
        action = "unchanged"
    return new_text, action


def write_blocks(shell_file: Path, specs: list[tuple[str, str, str]]) -> list[tuple[str, str]]:
    """Insert/replace several managed blocks in one read → backup → write pass.

    `specs` is a list of (label, block_text, begin_sentinel) — the end sentinel is
    derived by pairing (waypoints vs launch) so callers stay terse. Backs up the
    file at most once, and only if something actually changed. Returns a list of
    (label, action) for reporting.
    """
    original = shell_file.read_text(encoding="utf-8") if shell_file.exists() else ""
    text = original
    results: list[tuple[str, str]] = []
    for label, block, begin in specs:
        end = LAUNCH_END if begin == LAUNCH_BEGIN else END
        text, action = _apply_block(text, block, begin, end)
        results.append((label, action))

    if text != original:
        backup_shell_file(shell_file)
        shell_file.parent.mkdir(parents=True, exist_ok=True)
        shell_file.write_text(text, encoding="utf-8")
    return results


# --------------------------------------------------------------------------- #
# Command implementations
# --------------------------------------------------------------------------- #

def cmd_sync(args) -> int:
    shell_file = Path(args.shell_file) if args.shell_file else default_shell_file()
    wps = load_db()
    launches = load_launches()
    template = load_launch_template()
    machine = current_machine(args.machine)

    wp_block = render_block(wps, machine)
    launch_block = render_launch_block(launches, wps, machine, template)
    results = write_blocks(shell_file, [
        ("waypoints", wp_block, BEGIN),
        ("launch", launch_block, LAUNCH_BEGIN),
    ])

    changed = [(lbl, act) for lbl, act in results if act != "unchanged"]
    if not changed:
        ok(f"Shell file already up to date ({shell_file}).")
    else:
        for lbl, act in results:
            if act == "unchanged":
                continue
            if act == "deduped+updated":
                ok(f"{lbl} block updated in {shell_file}.")
                warn(f"Found and removed duplicate {lbl} block(s); collapsed to exactly one.")
            else:
                ok(f"{lbl} block {act} in {shell_file}.")

    # Post-sync existence check (warn-but-export policy), scoped to whatever this
    # machine actually resolves. Blocked entries are excluded — they aren't exported.
    for w in resolve_for_machine(wps, machine):
        if not w.exists():
            warn(f"{w.name} -> {w.path} (directory not found; variable still exported)")

    # Launches whose directory can't be resolved here are skipped (not an error).
    wp_paths = {w.name.upper(): w.path for w in resolve_for_machine(wps, machine)}
    for l in resolve_for_machine(launches, machine):
        if resolve_launch_dir(l, wp_paths) is None:
            ref = f"waypoint '{l.waypoint}'" if l.waypoint else "path"
            warn(f"launch {l.name}: {ref} not available on this machine; not rendered here.")

    if changed:
        info("Open a new terminal or run:  source " + str(shell_file))
    return 0


def cmd_add(args) -> int:
    name = args.name
    if not VALID_NAME.match(name):
        die(f"'{name}' is not a valid shell identifier (letters/digits/underscore, not starting with a digit).")

    abspath = expand(args.path)
    # Unlike the read commands, a missing --machine here means "universal"
    # (blank), NOT "this machine" — otherwise a plain `add` would silently stop
    # propagating to every other machine, breaking today's default behavior.
    machine_key = (args.machine or "").strip().lower()
    wps = load_db()

    # A block is name-wide and machine-independent: it shouldn't be possible to
    # sneak a new machine-scoped row under a blocked name without --force.
    blocked_row = next((w for w in wps if w.name.upper() == name.upper() and is_blocked(w)), None)
    if blocked_row and not args.force:
        die(f"'{name}' is blocked (a deliberate exclusion). Re-add with --force to override, "
            f"or run `waypoint unblock {name}` first.")

    existing = {(w.name.upper(), w.machine.lower()): w for w in wps}
    scope = f" (machine: {machine_key})" if machine_key else ""
    key = (name.upper(), machine_key)

    if key in existing:
        w = existing[key]
        w.path = abspath
        w.status = "active"
        if args.note is not None:
            w.notes = args.note
        info(f"Updated existing waypoint {w.name}{scope}.")
    else:
        wps.append(Waypoint(name=name, path=abspath, notes=args.note or "", machine=machine_key))
        info(f"Added waypoint {name}{scope}.")

    if not Path(abspath).is_dir():
        warn(f"Path does not currently exist: {abspath} (adding anyway).")

    save_db(wps)
    return cmd_sync(args)


def cmd_remove(args) -> int:
    name = args.name
    wps = load_db()

    if args.machine is not None:
        machine_key = args.machine.strip().lower()
        kept = [w for w in wps if not (w.name.upper() == name.upper() and w.machine.lower() == machine_key)]
        scope = f" (machine: {machine_key or 'universal'})"
    else:
        kept = [w for w in wps if w.name.upper() != name.upper()]
        scope = " (all machines)"

    if len(kept) == len(wps):
        die(f"No waypoint named '{name}'{scope}.")
    save_db(kept)
    ok(f"Removed waypoint {name}{scope}.")
    return cmd_sync(args)


def cmd_block(args) -> int:
    """Mark a name as a deliberate exclusion.

    Works whether or not the name is currently tracked: if it exists it is
    flipped to 'blocked' (and dropped from the shell file on the following
    sync); if it doesn't exist yet, a placeholder blocked entry is recorded so
    the exclusion is remembered for the future. A path is optional.
    """
    name = args.name
    if not VALID_NAME.match(name):
        die(f"'{name}' is not a valid shell identifier.")
    wps = load_db()
    existing = {w.name.upper(): w for w in wps}
    if name.upper() in existing:
        w = existing[name.upper()]
        w.status = "blocked"
        if args.note is not None:
            w.notes = args.note
    else:
        wps.append(Waypoint(name=name, path=expand(args.path) if args.path else "",
                            status="blocked", notes=args.note or "deliberate exclusion"))
    save_db(wps)
    ok(f"Blocked {name} (recorded as an exclusion; will not be exported).")
    return cmd_sync(args)


def cmd_unblock(args) -> int:
    """Lift a block. The entry becomes active again (needs a valid path to export)."""
    name = args.name
    wps = load_db()
    existing = {w.name.upper(): w for w in wps}
    if name.upper() not in existing:
        die(f"No entry named '{name}'.")
    w = existing[name.upper()]
    if not is_blocked(w):
        info(f"{name} is not blocked; nothing to do.")
        return 0
    w.status = "active"
    save_db(wps)
    ok(f"Unblocked {name}." + ("" if w.path else " Note: it has no path yet — set one with `waypoint add`."))
    return cmd_sync(args)


def cmd_list(args) -> int:
    wps = sorted(load_db(), key=lambda w: (w.name.upper(), w.machine.lower()))
    if not wps:
        info("No waypoints defined. Add one with:  waypoint add NAME PATH")
        return 0

    machine = current_machine(args.machine)
    winners = {id(w) for w in resolve_for_machine(wps, machine)}

    name_w = max(len(w.name) for w in wps)
    mach_w = max((len(w.machine) for w in wps), default=1)
    mach_w = max(mach_w, len("MACHINE"), 1)
    print(f"{C.d}{'NAME'.ljust(name_w)}  STATUS   {'MACHINE'.ljust(mach_w)}  PATH{C.x}")
    for w in wps:
        mach_label = (w.machine or "*").ljust(mach_w)
        if is_blocked(w):
            mark = f"{C.d}block{C.x}"
            line = f"{C.d}{w.name.ljust(name_w)}{C.x}  {mark}    {mach_label}  {C.d}{w.path or '(no path)'}{C.x}"
        elif id(w) in winners:
            exists = w.exists()
            mark = f"{C.g}ok{C.x}   " if exists else f"{C.r}MISS{C.x} "
            line = f"{w.name.ljust(name_w)}  {mark}   {mach_label}  {w.path}"
            if not exists:
                line += f"  {C.y}(not found){C.x}"
        else:
            # A row scoped to a different machine than this one: informational,
            # not an existence check (it isn't expected to exist here).
            line = f"{C.d}{w.name.ljust(name_w)}  other   {mach_label}  {w.path}{C.x}"
        print(line)
        if w.notes:
            print(f"{' ' * name_w}         {C.d}{w.notes}{C.x}")
    return 0


def cmd_doctor(args) -> int:
    shell_file = Path(args.shell_file) if args.shell_file else default_shell_file()
    wps = load_db()
    machine = current_machine(args.machine)

    launches = load_launches()
    template = load_launch_template()

    print(f"{C.b}Waypoint doctor{C.x}")
    print(f"  database   : {DB_PATH} {'(ok)' if DB_PATH.exists() else C.r + '(MISSING)' + C.x}")
    print(f"  launches   : {LAUNCH_DB_PATH} {'(ok)' if LAUNCH_DB_PATH.exists() else C.y + '(none yet)' + C.x}")
    print(f"  shell file : {shell_file} {'(ok)' if shell_file.exists() else C.y + '(not present)' + C.x}")
    print(f"  machine    : {machine}")

    # Are both managed blocks present, singular, and matching what we'd render?
    if shell_file.exists():
        text = shell_file.read_text(encoding="utf-8")
        for label, begin, end, expected in (
            ("waypoints", BEGIN, END, render_block(wps, machine)),
            ("launch", LAUNCH_BEGIN, LAUNCH_END, render_launch_block(launches, wps, machine, template)),
        ):
            n_blocks = count_blocks(text, begin, end)
            if n_blocks == 0:
                warn(f"{label} block not found in shell file. Run `waypoint sync` to create it.")
                continue
            if n_blocks > 1:
                err(f"{n_blocks} {label} blocks found (should be 1). This can break shell startup. "
                    f"Run `waypoint sync` to collapse them into one.")
            current = extract_block(text, begin, end)
            if current == expected and n_blocks == 1:
                ok(f"{label} block is present and in sync with the database.")
            elif current != expected:
                warn(f"{label} block is OUT OF SYNC with the database. Run `waypoint sync`.")

    # Duplicate detection: (name, machine) is the real uniqueness key now, since
    # the same name may legitimately have one row per machine.
    seen: dict[tuple[str, str], int] = {}
    for w in wps:
        seen[(w.name.upper(), w.machine.lower())] = seen.get((w.name.upper(), w.machine.lower()), 0) + 1
    dups = [k for k, c in seen.items() if c > 1]
    if dups:
        err("Duplicate (name, machine) rows in database: "
            + ", ".join(f"{n}@{m or '*'}" for n, m in dups))

    lseen: dict[tuple[str, str], int] = {}
    for l in launches:
        lseen[(l.name.upper(), l.machine.lower())] = lseen.get((l.name.upper(), l.machine.lower()), 0) + 1
    ldups = [k for k, c in lseen.items() if c > 1]
    if ldups:
        err("Duplicate (name, machine) launch rows: "
            + ", ".join(f"{n}@{m or '*'}" for n, m in ldups))

    # Path existence, scoped to what this machine actually resolves (blocked
    # entries are excluded by resolve_for_machine — they aren't exported).
    resolved = resolve_for_machine(wps, machine)
    n_ok = 0
    for w in resolved:
        if w.exists():
            n_ok += 1
        else:
            warn(f"{w.name}: path missing -> {w.path}")
    blocked_names = sorted({w.name for w in wps if is_blocked(w)})
    if blocked_names:
        info(f"{len(blocked_names)} blocked (excluded): {', '.join(blocked_names)}")

    total = len(resolved)
    print(f"\n{C.g if n_ok == total else C.y}{n_ok}/{total} tracked paths exist on this machine ({machine}).{C.x}")

    # Launch aliases: how many resolve to a runnable directory on this machine.
    wp_paths = {w.name.upper(): w.path for w in resolved}
    lresolved = resolve_for_machine(launches, machine)
    l_ok = 0
    for l in lresolved:
        directory = resolve_launch_dir(l, wp_paths)
        if directory is None:
            ref = f"waypoint '{l.waypoint}'" if l.waypoint else "path"
            warn(f"launch {l.name}: {ref} not resolvable here; not rendered.")
        elif not Path(directory).is_dir():
            warn(f"launch {l.name}: directory missing -> {directory}")
        else:
            l_ok += 1
    l_total = len(lresolved)
    if l_total:
        print(f"{C.g if l_ok == l_total else C.y}{l_ok}/{l_total} launch aliases runnable on this machine ({machine}).{C.x}")

    healthy = (n_ok == total and l_ok == l_total and not dups and not ldups)
    return 0 if healthy else 1


def cmd_import(args) -> int:
    """Rebuild the database from the managed block in the shell file.

    This is the recovery path for a lost/damaged waypoints.md. We parse the
    `export NAME='PATH'` lines out of the managed block. Notes/added-dates are
    not stored in the shell file, so recovered entries get today's date and an
    'imported' note; edit waypoints.md afterward if you want to restore them.
    """
    shell_file = Path(args.shell_file) if args.shell_file else default_shell_file()
    if not shell_file.exists():
        die(f"Shell file not found: {shell_file}")

    block = extract_block(shell_file.read_text(encoding="utf-8"))
    if block is None:
        die("No managed block found in the shell file; nothing to import.")

    # Match:  export NAME='...'   (single-quoted, with '\'' escapes)
    export_re = re.compile(r"^export\s+([A-Za-z_][A-Za-z0-9_]*)=(.+)$")
    recovered: list[Waypoint] = []
    for line in block.splitlines():
        m = export_re.match(line.strip())
        if not m:
            continue
        name, rawval = m.group(1), m.group(2).strip()
        path = _unquote_sh(rawval)
        recovered.append(Waypoint(name=name, path=path, notes="imported from shell block"))

    if not recovered:
        die("Managed block contained no exports to import.")

    if DB_PATH.exists() and not args.force:
        die(f"{DB_PATH} already exists. Re-run with --force to overwrite it from the shell block.")

    save_db(recovered)
    ok(f"Recovered {len(recovered)} waypoint(s) into {DB_PATH}.")
    info("Recovered rows are universal (blank Machine): the shell file only ever holds "
         "the single already-resolved path for whichever machine rendered it, so any "
         "machine-specific scoping from before is lost. Re-add --machine overrides by hand if needed.")
    for w in sorted(recovered, key=lambda w: w.name.upper()):
        print(f"  {w.name} -> {w.path}")

    # Best-effort launch recovery from the launch block, if present. This is
    # lossy: the block records only the resolved directory and final command, not
    # the original waypoint reference or template, so recovered launches are
    # stored as explicit-path rows with the literal command.
    lblock = extract_block(shell_file.read_text(encoding="utf-8"), LAUNCH_BEGIN, LAUNCH_END)
    if lblock is not None:
        arm_re = re.compile(r"^\S+?\|(\S+)\)\s+cd\s+(.+?)\s+&&\s+(.+?)\s*;;\s*$")
        lrecovered: list[Launch] = []
        for line in lblock.splitlines():
            m = arm_re.match(line.strip())
            if not m:
                continue
            lname, rawdir, cmd = m.group(1), m.group(2).strip(), m.group(3).strip()
            lrecovered.append(Launch(name=lname, path=_unquote_sh(rawdir), command=cmd,
                                     notes="imported from shell block"))
        if lrecovered:
            if LAUNCH_DB_PATH.exists() and not args.force:
                warn(f"{LAUNCH_DB_PATH} exists; not overwriting launches (re-run import with --force).")
            else:
                save_launches(lrecovered, DEFAULT_LAUNCH_TEMPLATE)
                ok(f"Recovered {len(lrecovered)} launch alias(es) into {LAUNCH_DB_PATH}.")
                for l in sorted(lrecovered, key=lambda l: l.name.upper()):
                    print(f"  launch {l.name} -> {l.path}")
    return 0


def _unquote_sh(token: str) -> str:
    """Inverse of sh_squote for the single-quoted forms we emit."""
    token = token.strip()
    if len(token) >= 2 and token[0] == "'" and token[-1] == "'":
        inner = token[1:-1]
        return inner.replace("'\\''", "'")
    # Fallback: strip surrounding double quotes if present.
    if len(token) >= 2 and token[0] == '"' and token[-1] == '"':
        return token[1:-1]
    return token


def link_cli_into_data_dir() -> None:
    """Make `<data dir>/waypoint` a symlink to this executable (idempotent).

    Tools that read the tables (a dashboard, a repo-rename census) then find the CLI that
    edits them in the same directory, without knowing where this checkout lives."""
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    link, exe = DATA_DIR / "waypoint", HERE / "waypoint"
    if link.is_symlink() and Path(os.readlink(link)) == exe:
        return
    if link.exists() and not link.is_symlink():
        warn(f"{link} exists and is not a symlink; leaving it alone.")
        return
    if link.is_symlink():
        link.unlink()
    link.symlink_to(exe)
    info(f"Linked {link} -> {exe}")


def cmd_install(args) -> int:
    """Ensure both managed blocks exist (idempotent; same as sync but friendlier)."""
    link_cli_into_data_dir()
    if not DB_PATH.exists():
        info(f"No waypoints database yet; creating an empty one at {DB_PATH}.")
        save_db([])
    if not LAUNCH_DB_PATH.exists():
        info(f"No launches database yet; creating an empty one at {LAUNCH_DB_PATH}.")
        save_launches([], DEFAULT_LAUNCH_TEMPLATE)
    return cmd_sync(args)


def cmd_uninstall(args) -> int:
    shell_file = Path(args.shell_file) if args.shell_file else default_shell_file()
    if not shell_file.exists():
        die(f"Shell file not found: {shell_file}")
    text = shell_file.read_text(encoding="utf-8")

    # Remove BOTH managed blocks (waypoints and launch), each wherever it appears.
    spans: list[tuple[int, int]] = []
    for begin, end in ((BEGIN, END), (LAUNCH_BEGIN, LAUNCH_END)):
        spans.extend(find_all_blocks(text, begin, end))
    if not spans:
        info("No managed blocks present; nothing to uninstall.")
        return 0
    # Excise from the tail forward so offsets stay valid.
    for b, e in sorted(spans, reverse=True):
        tail = text[e:]
        if tail.startswith("\n"):
            e += 1
        text = text[:b] + text[e:]
    # Tidy any excess blank lines left behind.
    text = re.sub(r"\n{3,}", "\n\n", text)
    backup_shell_file(shell_file)
    shell_file.write_text(text, encoding="utf-8")
    ok(f"Removed managed block(s) from {shell_file}. Databases left intact.")
    info("Open a new terminal or run:  source " + str(shell_file))
    return 0


