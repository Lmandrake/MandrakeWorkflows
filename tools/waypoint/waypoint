def cmd_launch_add(args) -> int:
    name = args.name
    if not VALID_NAME.match(name):
        die(f"'{name}' is not a valid shell identifier (letters/digits/underscore, not starting with a digit).")
    if bool(args.waypoint) == bool(args.path):
        die("Provide exactly one of --waypoint NAME (preferred) or --path DIR.")

    machine_key = (args.machine or "").strip().lower()
    launches = load_launches()
    template = load_launch_template()

    wp_ref, path_val = "", ""
    if args.waypoint:
        wp_ref = args.waypoint
        if wp_ref.upper() not in {w.name.upper() for w in load_db()}:
            warn(f"No waypoint named '{wp_ref}' in the database yet (adding the alias anyway).")
    else:
        path_val = expand(args.path)
        if not Path(path_val).is_dir():
            warn(f"Path does not currently exist: {path_val} (adding anyway).")

    existing = {(l.name.upper(), l.machine.lower()): l for l in launches}
    scope = f" (machine: {machine_key})" if machine_key else ""
    key = (name.upper(), machine_key)
    if key in existing:
        l = existing[key]
        l.waypoint, l.path = wp_ref, path_val
        if args.cmd is not None:
            l.command = args.cmd
        if args.note is not None:
            l.notes = args.note
        l.status = "active"
        info(f"Updated launch alias {l.name}{scope}.")
    else:
        launches.append(Launch(name=name, waypoint=wp_ref, path=path_val,
                               command=args.cmd or "", notes=args.note or "", machine=machine_key))
        info(f"Added launch alias {name}{scope}.")

    save_launches(launches, template)
    return cmd_sync(args)


def cmd_launch_remove(args) -> int:
    name = args.name
    launches = load_launches()
    template = load_launch_template()
    if args.machine is not None:
        machine_key = args.machine.strip().lower()
        kept = [l for l in launches if not (l.name.upper() == name.upper() and l.machine.lower() == machine_key)]
        scope = f" (machine: {machine_key or 'universal'})"
    else:
        kept = [l for l in launches if l.name.upper() != name.upper()]
        scope = " (all machines)"
    if len(kept) == len(launches):
        die(f"No launch alias named '{name}'{scope}.")
    save_launches(kept, template)
    ok(f"Removed launch alias {name}{scope}.")
    return cmd_sync(args)


def cmd_launch_list(args) -> int:
    launches = sorted(load_launches(), key=lambda l: (l.name.upper(), l.machine.lower()))
    template = load_launch_template()
    print(f"{C.d}default template: {template}{C.x}")
